# Custom Suricata rules - CodeAlpha_NetworkIDS
# Install to /etc/suricata/rules/local.rules and list it under rule-files: in suricata.yaml

# 1. Nmap-style TCP SYN scan: 15+ SYN-only packets from one source within 5 seconds
alert tcp any any -> $HOME_NET any (msg:"LOCAL Nmap TCP SYN Scan Detected"; flags:S; threshold:type both, track by_src, count 15, seconds 5; classtype:network-scan; sid:1000001; rev:1;)

# 2. ICMP ping flood: 10+ echo requests from one source within 3 seconds
alert icmp any any -> $HOME_NET any (msg:"LOCAL ICMP Ping Flood Detected"; itype:8; threshold:type both, track by_src, count 10, seconds 3; classtype:attempted-dos; sid:1000002; rev:1;)

# 3. SQL injection (UNION ... SELECT) in the HTTP request URI
alert http any any -> $HOME_NET 80 (msg:"LOCAL Potential SQL Injection Attempt in HTTP URI"; flow:established,to_server; http.uri; content:"UNION"; nocase; content:"SELECT"; nocase; classtype:web-application-attack; sid:1000003; rev:1;)
